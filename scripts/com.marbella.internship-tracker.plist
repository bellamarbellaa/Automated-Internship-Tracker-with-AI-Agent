<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marbella.internship-tracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/marbellaelpantja/Documents/Claude Code Agentic Workflow/Internship Search Automation/scripts/run_weekly.sh</string>
    </array>

    <!--
      Fixed calendar dates only -- Sep 7, 14, 21 2026 at 8:00 AM local
