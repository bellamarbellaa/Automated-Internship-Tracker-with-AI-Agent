            <key>Day</key><integer>21</integer>
            <key>Hour</key><integer>8</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/marbellaelpantja/Documents/Claude Code Agentic Workflow/Internship Search Automation/logs/launchd_stdout.log</string>
